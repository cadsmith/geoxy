if (CMAKE_SCRIPT_MODE_FILE)
  include(${STAMP_SETTINGS})
  set(key "${STAMP_NAME}\n")
  foreach(pattern IN LISTS STAMP_INPUTS)
    file(GLOB_RECURSE found LIST_DIRECTORIES false ${pattern})
    list(SORT found)
    foreach(path IN LISTS found)
      file(SHA256 ${path} digest)
      string(APPEND key "${path} ${digest}\n")
    endforeach()
  endforeach()
  foreach(tool IN LISTS STAMP_TOOLS)
    if (EXISTS ${tool} AND NOT IS_DIRECTORY ${tool})
      file(REAL_PATH ${tool} real)
      file(TIMESTAMP ${real} made "%Y-%m-%dT%H:%M:%S" UTC)
      string(APPEND key "${tool} ${real} ${made}\n")
    endif()
  endforeach()
  string(SHA256 digest "${key}")
  set(passed ${STAMP_DIR}/${STAMP_NAME}-${digest})
  file(MAKE_DIRECTORY ${STAMP_DIR})
  file(LOCK ${STAMP_DIR}/${STAMP_NAME}.lock GUARD PROCESS)
  if (EXISTS ${passed})
    message(STATUS "${STAMP_NAME}: passed before, on these very inputs")
    return()
  endif()
  execute_process(COMMAND ${STAMP_COMMAND} RESULT_VARIABLE status)
  if (NOT status EQUAL 0)
    message(FATAL_ERROR "${STAMP_NAME} failed: ${status}")
  endif()
  file(TOUCH ${passed})
  return()
endif()

set(GEOXY_STAMPS ${PROJECT_BINARY_DIR}/stamps CACHE PATH
  "Where checks that passed are stamped, by a hash of what they check")
set(GEOXY_STAMP_SCRIPT ${CMAKE_CURRENT_LIST_FILE})

function(geoxy_stamp variable name)
  cmake_parse_arguments(PARSE_ARGV 2 stamp "" "" "INPUTS;TOOLS;COMMAND")
  set(text "")
  foreach(part IN ITEMS INPUTS TOOLS COMMAND)
    string(APPEND text "set(STAMP_${part}\n")
    foreach(word IN LISTS stamp_${part})
      string(APPEND text "  [==[${word}]==]\n")
    endforeach()
    string(APPEND text ")\n")
  endforeach()
  set(settings ${CMAKE_CURRENT_BINARY_DIR}/stamps/${name}.cmake)
  file(GENERATE OUTPUT ${settings} CONTENT "${text}")
  set(${variable}
    ${CMAKE_COMMAND} -DSTAMP_SETTINGS=${settings} -DSTAMP_NAME=${name}
    -DSTAMP_DIR=${GEOXY_STAMPS} -P ${GEOXY_STAMP_SCRIPT}
    PARENT_SCOPE
  )
endfunction()

{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GEOXY_STAMPS": "${sourceDir}/build/stamps"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GEOXY_ENABLE_BENCH": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1",
        "GEOXY_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Sanitize",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g",
        "GEOXY_ENABLE_SANITIZE": "ON"
      }
    },
    {
      "name": "tidy",
      "displayName": "Tidy",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GEOXY_ENABLE_TIDY": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzz",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GEOXY_ENABLE_FUZZ": "ON",
        "GEOXY_ENABLE_SANITIZE": "ON"
      }
    },
    {
      "name": "bench",
      "displayName": "Bench",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GEOXY_ENABLE_BENCH": "ON",
        "GEOXY_ENABLE_HARDENING": "OFF"
      }
    },
    {
      "name": "unity",
      "displayName": "Unity",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_UNITY_BUILD": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy",
      "targets": [
        "geoxy"
      ]
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "bench",
      "configurePreset": "bench",
      "targets": [
        "geoxy_bench"
      ]
    },
    {
      "name": "unity",
      "configurePreset": "unity",
      "targets": [
        "geoxy",
        "geoxy_tests",
        "geoxy_suites",
        "geoxy_scoreboard"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 8
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "displayName": "Debug Tests"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release",
      "displayName": "Release Tests"
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage",
      "displayName": "Coverage Tests"
    },
    {
      "name": "sanitize",
      "inherits": "base",
      "configurePreset": "sanitize",
      "displayName": "Sanitize Tests",
      "environment": {
        "ASAN_OPTIONS": "detect_stack_use_after_return=1:strict_string_checks=1:check_initialization_order=1:strict_init_order=1",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "Configure, build and test: debug",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "release",
      "displayName": "Configure, build and test: release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "sanitize",
      "displayName": "Configure, build and test: sanitize",
      "steps": [
        {
          "type": "configure",
          "name": "sanitize"
        },
        {
          "type": "build",
          "name": "sanitize"
        },
        {
          "type": "test",
          "name": "sanitize"
        }
      ]
    }
  ]
}

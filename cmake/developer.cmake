set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR}/bin)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR}/lib)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR}/lib)

if (GEOXY_ENABLE_CCACHE AND NOT CMAKE_CXX_COMPILER_LAUNCHER)
  find_program(GEOXY_CCACHE ccache)
  if (GEOXY_CCACHE)
    execute_process(COMMAND ${GEOXY_CCACHE} --print-version
      OUTPUT_VARIABLE GEOXY_CCACHE_VERSION ERROR_QUIET
      OUTPUT_STRIP_TRAILING_WHITESPACE)
    set(CMAKE_CXX_COMPILER_LAUNCHER ${GEOXY_CCACHE})
    if (GEOXY_CCACHE_VERSION VERSION_GREATER_EQUAL 4.8)
      list(APPEND CMAKE_CXX_COMPILER_LAUNCHER
        sloppiness=pch_defines,time_macros)
    endif()
  endif()
endif()

include(CTest)

find_package(Doxygen QUIET)
if (DOXYGEN_FOUND)
  add_custom_target(geoxy_docs
    COMMAND Doxygen::doxygen ${PROJECT_SOURCE_DIR}/Doxyfile
    WORKING_DIRECTORY ${PROJECT_SOURCE_DIR}
    VERBATIM
  )
endif()
